# Copy to extension/.env (never committed) and fill in. Reload the extension after editing.
# These fill the matching Settings fields that are left empty; a value typed and saved in Settings wins.
# Clear a Settings field (and Save) to go back to the .env value.

# Analyzer: bridge (debug, Claude Code) | anthropic (API key) | none
ANALYZER_MODE=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high
ANALYZER_EFFORT=low
BRIDGE_URL=http://127.0.0.1:8765

# Telegram (Settings → Telegram → Enabled still has to be ticked)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Relay server prefilled in Settings → Registration
RELAY_URL=https://relay-production-7643.up.railway.app/upwork
