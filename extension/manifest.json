{
  "manifest_version": 3,
  "name": "Say To Leads – Human Flow",
  "version": "0.1.0",
  "description": "Screen-driven, human-paced automation for one linked tab. Debug mode routes AI analysis through a local bridge (Claude Code).",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs", "scripting", "debugger", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Say To Leads",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options/options.html"
}
